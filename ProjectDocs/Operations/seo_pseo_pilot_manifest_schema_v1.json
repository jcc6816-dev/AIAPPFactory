{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genforms.ai/internal/schemas/seo-pseo-pilot-manifest-v1.json",
  "title": "GenForms pSEO Pilot Manifest V1",
  "description": "Prepare-only schema for a gated 5-10 page pSEO pilot. A valid manifest does not authorize publishing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["batchId", "family", "status", "evidence", "existingOwners", "pages", "batchQa", "measurement"],
  "properties": {
    "batchId": { "type": "string", "minLength": 1 },
    "family": { "enum": ["event_qr", "lead_capture", "waitlist"] },
    "status": { "enum": ["prepare", "hold", "brief_ready", "build_ready", "verified", "published", "frozen", "stopped"] },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "language", "serpFiles", "gscCutoffDate", "queryPageSignals"],
      "properties": {
        "region": { "type": "string", "minLength": 2 },
        "language": { "type": "string", "minLength": 2 },
        "serpFiles": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "gscCutoffDate": { "type": "string", "format": "date" },
        "queryPageSignals": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["query", "ownerUrl", "impressions", "position", "window"],
            "properties": {
              "query": { "type": "string", "minLength": 1 },
              "ownerUrl": { "type": "string", "minLength": 1 },
              "impressions": { "type": "number", "minimum": 0 },
              "position": { "type": "number", "minimum": 1 },
              "window": { "enum": ["7d", "28d", "custom"] }
            }
          }
        }
      }
    },
    "existingOwners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "pageType", "owningIntent", "protectedQueries"],
        "properties": {
          "url": { "type": "string", "minLength": 1 },
          "pageType": { "enum": ["pillar", "template", "solution", "post", "other"] },
          "owningIntent": { "type": "string", "minLength": 1 },
          "protectedQueries": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 5,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "slug", "pageType", "owningQuery", "userTask", "templateId", "prompt", "fields", "uniqueWorkflow", "productLimits", "cta", "internalLinks", "seo", "uniqueness"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "pageType": { "enum": ["template", "solution", "use_case", "post"] },
          "owningQuery": { "type": "string", "minLength": 1 },
          "userTask": { "type": "string", "minLength": 20 },
          "templateId": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 30 },
          "fields": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "label", "type", "required", "taskSpecific"],
              "properties": {
                "key": { "type": "string", "minLength": 1 },
                "label": { "type": "string", "minLength": 1 },
                "type": { "type": "string", "minLength": 1 },
                "required": { "type": "boolean" },
                "taskSpecific": { "type": "boolean" }
              }
            }
          },
          "uniqueWorkflow": { "type": "string", "minLength": 30 },
          "productLimits": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "cta": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "intent", "template", "prompt"],
            "properties": {
              "source": { "type": "string", "minLength": 1 },
              "intent": { "type": "string", "minLength": 1 },
              "template": { "type": "string", "minLength": 1 },
              "prompt": { "type": "string", "minLength": 30 }
            }
          },
          "internalLinks": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["target", "reason"],
              "properties": {
                "target": { "type": "string", "minLength": 1 },
                "reason": { "type": "string", "minLength": 10 }
              }
            }
          },
          "seo": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "description", "h1", "canonical", "schemaTypes"],
            "properties": {
              "title": { "type": "string", "minLength": 10 },
              "description": { "type": "string", "minLength": 40 },
              "h1": { "type": "string", "minLength": 10 },
              "canonical": { "type": "string", "minLength": 1 },
              "schemaTypes": { "type": "array", "minItems": 1, "items": { "enum": ["SoftwareApplication", "FAQPage", "BreadcrumbList", "Article"] } }
            }
          },
          "uniqueness": {
            "type": "object",
            "additionalProperties": false,
            "required": ["distinctFrom", "taskSpecificFieldCount", "uniqueModules", "reviewStatus"],
            "properties": {
              "distinctFrom": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "taskSpecificFieldCount": { "type": "integer", "minimum": 2 },
              "uniqueModules": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "reviewStatus": { "enum": ["pending", "pass", "hold", "reject"] }
            }
          }
        }
      }
    },
    "batchQa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manualReviewCoverage", "ownershipChecked", "productTruthChecked", "pairwiseSimilarityReviewed", "ctaE2eChecked", "technicalSeoChecked"],
      "properties": {
        "manualReviewCoverage": { "const": 100 },
        "ownershipChecked": { "type": "boolean" },
        "productTruthChecked": { "type": "boolean" },
        "pairwiseSimilarityReviewed": { "type": "boolean" },
        "ctaE2eChecked": { "type": "boolean" },
        "technicalSeoChecked": { "type": "boolean" }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publishDate", "reviewDates", "events", "stopRules"],
      "properties": {
        "publishDate": { "type": ["string", "null"], "format": "date" },
        "reviewDates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["day14", "day28", "day45"],
          "properties": {
            "day14": { "type": ["string", "null"], "format": "date" },
            "day28": { "type": ["string", "null"], "format": "date" },
            "day45": { "type": ["string", "null"], "format": "date" }
          }
        },
        "events": {
          "type": "array",
          "minItems": 4,
          "items": { "enum": ["organic_landing", "template_use_click", "form_generate", "form_publish", "form_submit", "upgrade_intent", "qualified_lead"] }
        },
        "stopRules": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } }
      }
    }
  }
}
